<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" >
    <item>
        <shape android:shape="oval" >
            <gradient
                android:angle="0"
                android:gradientRadius="4dp"
                android:startColor="@color/dyn_primary_color_dark"
                android:endColor="@color/dyn_primary_color"/>
            <size android:width="24dp"
                android:height="24dp"/>
        </shape>
    </item>

    <item
        android:bottom="7dp"
        android:left="7dp"
        android:right="7dp"
        android:top="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/dyn_primary_color" />
            <size android:width="10dp"
                android:height="10dp"/>
        </shape>
    </item>
</layer-list>