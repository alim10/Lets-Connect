    <declare-styleable name="AppHeader">
        <attr name="headerTitle" format="string" />
        <attr name="headerSubtitle" format="string" />
        <attr name="headerIcon" format="reference" />
        <attr name="headerEndIcon" format="reference" />
        <attr name="wavesDrawable" format="reference" />
        <attr name="progressEnabled" format="boolean" />
        <attr name="progress" format="integer" />
        <attr name="isReversed" format="boolean" />
        <attr name="headerTextColor" format="color" />
        <attr name="headerSubtitleTextColor" format="color" />
        <attr name="headerTitleTextSize" format="float" />
        <attr name="headerIconVisibility">
            <!-- Visible on screen; the default value. -->
            <enum name="visible" value="0" />
            <!-- Not displayed, but taken into account during layout (space is left for it). -->
            <enum name="invisible" value="1" />
            <!-- Completely hidden, as if the view had not been added. -->
            <enum name="gone" value="2" />
        </attr>
        <attr name="headerEndIconVisibility">
            <!-- Visible on screen; the default value. -->
            <enum name="visible" value="0" />
            <!-- Not displayed, but taken into account during layout (space is left for it). -->
            <enum name="invisible" value="1" />
            <!-- Completely hidden, as if the view had not been added. -->
            <enum name="gone" value="2" />
        </attr>
        <attr name="titleTextAlignment" format="integer">
            <!-- Default. -->
            <enum name="inherit" value="0" />
            <!-- Default for the root view. The gravity determines the alignment, ALIGN_NORMAL,
                ALIGN_CENTER, or ALIGN_OPPOSITE, which are relative to each paragraph’s
                text direction. -->
            <enum name="gravity" value="1" />
            <!-- Align to the start of the paragraph, for example: ALIGN_NORMAL. -->
            <enum name="textStart" value="2" />
            <!-- Align to the end of the paragraph, for example: ALIGN_OPPOSITE. -->
            <enum name="textEnd" value="3" />
            <!-- Center the paragraph, for example: ALIGN_CENTER. -->
            <enum name="center" value="4" />
            <!-- Align to the start of the view, which is ALIGN_LEFT if the view’s resolved
                layoutDirection is LTR, and ALIGN_RIGHT otherwise. -->
            <enum name="viewStart" value="5" />
            <!-- Align to the end of the view, which is ALIGN_RIGHT if the view’s resolved
                layoutDirection is LTR, and ALIGN_LEFT otherwise. -->
            <enum name="viewEnd" value="6" />
        </attr>
        <attr name="extended" format="boolean" />
        <attr name="centerIcon" format="reference" />
        <attr name="heightPercent" format="float" />
        <attr name="wavesBackground" format="integer">
            <!-- Default. -->
            <enum name="lilac" value="0" />
            <enum name="white" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="ProgressButton">
        <attr name="android:enabled" format="boolean" />
        <attr name="backgroundEnabledColor" format="color" />
        <attr name="buttonCornerRadius" format="dimension" />
        <attr name="android:icon" format="reference" />
        <attr name="android:textColor" format="color" />
        <attr name="android:textSize" format="dimension" />
        <attr name="android:text" format="string" />
        <attr name="customTextStyle" format="reference">
            <flag name="normal" value="0" />
            <flag name="bold" value="1" />
            <flag name="italic" value="2" />
        </attr>
        <attr name="lightTheme" format="boolean" />
        <attr name="isChecked" format="boolean" />
        <attr name="contentDisabledColor" format="color" />
        <attr name="backgroundDisabledColor" format="color" />
        <attr name="customIconGravity" format="integer">
            <!-- Push icon to the start of the button. -->
            <flag name="start" value="0x1" />
            <!-- Push the icon to the start of the text keeping a distance equal to
                 {@link R.attr#iconPadding} from the text. -->
            <flag name="textStart" value="0x2" />
            <!-- Push icon to the end of the button. -->
            <flag name="end" value="0x3" />
            <!-- Push the icon to the end of the text keeping a distance equal to
                 {@link R.attr#iconPadding} from the text. -->
            <flag name="textEnd" value="0x4" />
            <!-- Push the icon to the top of the button. -->
            <flag name="top" value="0x10" />
            <!-- Push the icon to the top of the text keeping a distance equal to
                 {@link R.attr#iconPadding} from the text. -->
            <flag name="textTop" value="0x20" />
        </attr>
        <attr name="pb_strokeColor" format="color" />
        <attr name="strokeWidth" format="dimension" />
    </declare-styleable>

    <declare-styleable name="PrimaryTextView">
        <attr name="android:enabled" format="boolean" />
        <attr name="android:textColor" format="color" />
        <attr name="disabledColor" format="color" />
        <attr name="isButton" format="boolean" />
        <attr name="android:text" format="string" />
        <attr name="textViewCornerRadius" format="dimension" />
        <attr name="textViewBackgroundColor" format="color" />
        <attr name="android:drawableStart" format="reference|color" />
        <attr name="android:drawableEnd" format="reference|color" />
        <attr name="textPadding" format="dimension" />
        <attr name="textPaddingStart" format="dimension" />
        <attr name="textPaddingEnd" format="dimension" />
        <attr name="textPaddingBottom" format="dimension" />
        <attr name="textPaddingTop" format="dimension" />
        <attr name="android:textStyle" format="reference">
            <flag name="normal" value="0" />
            <flag name="bold" value="1" />
            <flag name="italic" value="2" />
        </attr>
        <attr name="android:textAlignment" format="integer">
            <!-- Default. -->
            <enum name="inherit" value="0" />
            <!-- Default for the root view. The gravity determines the alignment, ALIGN_NORMAL,
                ALIGN_CENTER, or ALIGN_OPPOSITE, which are relative to each paragraph’s
                text direction. -->
            <enum name="gravity" value="1" />
            <!-- Align to the start of the paragraph, for example: ALIGN_NORMAL. -->
            <enum name="textStart" value="2" />
            <!-- Align to the end of the paragraph, for example: ALIGN_OPPOSITE. -->
            <enum name="textEnd" value="3" />
            <!-- Center the paragraph, for example: ALIGN_CENTER. -->
            <enum name="center" value="4" />
            <!-- Align to the start of the view, which is ALIGN_LEFT if the view’s resolved
                layoutDirection is LTR, and ALIGN_RIGHT otherwise. -->
            <enum name="viewStart" value="5" />
            <!-- Align to the end of the view, which is ALIGN_RIGHT if the view’s resolved
                layoutDirection is LTR, and ALIGN_LEFT otherwise. -->
            <enum name="viewEnd" value="6" />
        </attr>
        <attr name="customTextDirection" format="integer">
            <!-- Default. -->
            <enum name="inherit" value="0" />
            <!-- Default for the root view. The first strong directional character determines the
                 paragraph direction.  If there is no strong directional character, the paragraph
                 direction is the view’s resolved layout direction. -->
            <enum name="firstStrong" value="1" />
            <!-- The paragraph direction is RTL if it contains any strong RTL character, otherwise
                 it is LTR if it contains any strong LTR characters.  If there are neither, the
                 paragraph direction is the view’s resolved layout direction. -->
            <enum name="anyRtl" value="2" />
            <!-- The paragraph direction is left to right. -->
            <enum name="ltr" value="3" />
            <!-- The paragraph direction is right to left. -->
            <enum name="rtl" value="4" />
            <!-- The paragraph direction is coming from the system Locale. -->
            <enum name="locale" value="5" />
            <!-- The first strong directional character determines the paragraph direction. If
                 there is no strong directional character, the paragraph direction is LTR. -->
            <enum name="firstStrongLtr" value="6" />
            <!-- The first strong directional character determines the paragraph direction. If
                 there is no strong directional character, the paragraph direction is RTL. -->
            <enum name="firstStrongRtl" value="7" />
        </attr>
        <attr name="customLayoutDirection" format="reference">
            <!-- Left-to-Right. -->
            <enum name="ltr" value="0" />
            <!-- Right-to-Left. -->
            <enum name="rtl" value="1" />
            <!-- Inherit from parent. -->
            <enum name="inherit" value="2" />
            <!-- Locale. -->
            <enum name="locale" value="3" />
        </attr>
        <attr name="android:textSize" format="dimension" />
        <attr name="android:textAllCaps" format="boolean" />
    </declare-styleable>

