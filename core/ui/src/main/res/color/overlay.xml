<?xml version="1.0" encoding="utf-8"?>
<!-- Use @color/dyn_* aliases (not ?attr/...) so RemoteColorResources.getValue
     remaps to the active cluster. Material's elevationOverlayColor → dyn_black
     (the standard elevation tint; alpha 0.60 preserved). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.60" android:color="@color/dyn_black"/>
</selector>
