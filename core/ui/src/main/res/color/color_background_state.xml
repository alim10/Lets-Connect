<?xml version="1.0" encoding="utf-8"?>
<!-- Use @color/dyn_* aliases (not ?attr/...) so RemoteColorResources.getValue
     remaps to the active cluster. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/dyn_primary_background" android:state_checked="true" />

    <item android:color="@color/dyn_white" android:state_checked="false" />
</selector>