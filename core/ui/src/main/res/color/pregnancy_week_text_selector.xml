<?xml version="1.0" encoding="utf-8"?>
<!-- Use @color/dyn_* aliases (not ?attr/...) so RemoteColorResources.getValue
     remaps to the active cluster. colorSecondary → primaryColor in our theme. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/dyn_primary_color" android:state_selected="true" />
    <item android:color="@color/dyn_grey" />
</selector>
